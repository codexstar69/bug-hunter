{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "schemaVersion": 1,
  "artifact": "skeptic",
  "title": "Bug Hunter Skeptic Artifact",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["bugId", "response", "analysisSummary"],
    "properties": {
      "bugId": { "type": "string", "minLength": 1 },
      "response": {
        "type": "string",
        "enum": ["ACCEPT", "DISPROVE", "MANUAL_REVIEW"]
      },
      "analysisSummary": { "type": "string", "minLength": 1 },
      "counterEvidence": { "type": "string", "minLength": 1 }
    },
    "additionalProperties": false,
    "allOf": [
      {
        "if": { "properties": { "response": { "const": "DISPROVE" } }, "required": ["response"] },
        "then": {
          "required": ["counterEvidence"],
          "properties": {
            "counterEvidence": {
              "type": "string",
              "pattern": "(?:^|[\\s(\"'`])(?:\\.{1,2}/|/)?(?:[A-Za-z0-9_.@+$~()\\[\\]-]+/)*[A-Za-z0-9_.@+$~(\\[-][A-Za-z0-9_.@+$~()\\[\\]-]*\\.[A-Za-z][A-Za-z0-9]*:[1-9][0-9]*\\b"
            }
          }
        }
      }
    ]
  }
}
